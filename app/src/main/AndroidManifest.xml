<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Servizio in primo piano per il polling IMAP e per l'ascolto continuo delle
         notifiche Outlook: deve restare vivo anche a schermo spento mentre si guida. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application android:name=".MailApplication" android:theme="@style/CarAppTheme"
        android:label="@string/app_name" android:allowBackup="true"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">

        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.theme" android:resource="@style/CarAppTheme" />

        <service android:name=".MailCarAppService" android:exported="true"
            android:label="@string/app_name_car">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Attività sul telefono per configurare account e modalità -->
        <activity android:name=".SettingsActivity" android:exported="true"
            android:label="Impostazioni - Android Auto Mail Collector" android:theme="@style/SettingsTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Modalità "Notifiche Outlook": legge le notifiche già mostrate dall'app Outlook -->
        <service android:name=".NotificationCaptureService" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Modalità "IMAP diretto": controlla periodicamente le caselle configurate -->
        <service android:name=".ImapPollService" android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Riavvia il servizio IMAP dopo il riavvio del telefono, se la modalità è attiva -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Riceve il tocco sulla notifica (dal telefono o dall'auto) e avvia la lettura vocale -->
        <receiver android:name=".ReadMailReceiver" android:exported="false" />

    </application>
</manifest>
